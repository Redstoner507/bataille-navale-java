@startuml BatailleNavale
'https://plantuml.com/class-diagram

skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
hide enum methods
hide interface attributes

class Main {
    +main(args: String[]): void
}

package model {

    enum Orientation {
         HORIZONTAL_LEFT
         HORIZONTAL_RIGHT
         VERTICAL_UP
         VERTICAL_DOWN
    }

    enum CellState {
        EMPTY
        SHIP_SEGMENT
        HIT
    }

    class Grid {
        - {static} MIN_SIZE : Integer
        - {static} MAX_SIZE : Integer
        - _size : Integer
        + <<Create>> Grid(size: Integer)
        + canPlaceShip(ship: Ship, startRow: Integer, startCol: Integer) : boolean
        + placeShip(ship: Ship, startRow: Integer, startCol: Integer) : boolean
        + getSize() : Integer
    }

    class Cell {
        - _isHit : Boolean
        - _hasShip : Boolean
        - _isSunk : Boolean
        + <<Create>> Cell()
        + isHit() : Boolean
        + hasShip() : Boolean
        + isSunk() : Boolean
        + hit() : void
        + placeShip() : void
    }

    package ship {
        class Ship {
            - _startRow : Integer
            - _startCol : Integer
            + <<Create>> Ship(type: ShipType)
            + getSize() : Integer
            + setOrientation(_orientation: Orientation)
            + getOrientation() : Orientation
            + setStart(row: Integer, col: Integer)
            + getStartRow() : Integer
            + getStartCol() : Integer
            + getType() : ShipType
            + getCoordinates() : Point[*]
        }

        abstract class ShipType {
            - _size : Integer
            + <<Create>> ShipType(size: Integer)
            + getSize() : Integer
        }

        class ShipFactory {
            + <<Create>> ShipFactory()
            + createShip(type: ShipType) : Ship
        }

        class Carrier implements ShipType {
            + <<Create>> Carrier()
        }
        class BattleShip implements ShipType {
            + <<Create>> BattleShip()
        }
        class Cruiser implements ShipType {
            + <<Create>> Cruiser()
        }
        class Submarine implements ShipType {
            + <<Create>> Submarine()
        }
        class Destroyer implements ShipType {
            + <<Create>> Destroyer()
        }
    }
}

package view {
    class GameView {
        - _statusLabel : JLabel
        + <<Create>> GameView(gridSize : Integer)
        + getPlayerGridView() : LabeledGridView
        + getComputerGridView() : LabeledGridView
        + setStatus(text : String)
    }

    class LabeledGridView {
        - _titleLabel : JLabel
        + <<Create>> LabeledGridView(title : String, gridSize : Integer)
        + <<Create>> LabeledGridView(title : String, gridSize : Integer, locked : Boolean)
        - setupComponents()
        + getGridView() : GridView
        + setTitle(title : String)
    }

    class GridView {
        - _gridSize : Integer
        - _cells : JButton[][]
        - _locked : Boolean
        + <<Create>> GridView(gridSize : Integer)
        - createGridPanel() : JPanel
        + setLocked(locked : Boolean)
        + setCellEnabled(row : Integer, col : Integer, enabled : Boolean)
        + addCellClickListener(listener : ActionListener)
        + getCell(row : Integer, col : Integer) : JButton
        + getGridSize() : Integer
        + isLocked() : Boolean
    }

    class CellView {
        - _segmentImage : Image
        - _isClickable : boolean
        + <<Create>> CellView()
        + setSegmentImage(imagePath: String)
        # paintComponent(g: Graphics)
        + addMouseListener(l: MouseListener)
        + setClickable(clickable: boolean)
        + isClickable() : boolean
    }

    class ShipView {
        + <<Create>> ShipView(ship: Ship)
    }

    class ConfigScreen {
        - {static} MAX_OCCUPIABLE_CELLS : Integer
        - _gridSizeSpinner : JSpinner
        - _carrierSpinner : JSpinner
        - _cruiserSpinner : JSpinner
        - _destroyerSpinner : JSpinner
        - _submarineSpinner : JSpinner
        - _torpedoSpinner : JSpinner
        - _islandCheckBox : JCheckBox
        - _backButton : JButton
        - _startPlacementButton : JButton
        - _occupiedCellsLabel : JLabel
        + <<Create>> ConfigScreen()
        - createShipSpinner(label : String) : JSpinner
        - getOccupiedCellsCount() : Integer
        - updateOccupiedCellsLabel(occupiedCells : Integer)
        + getBackButton() : JButton
        + getStartPlacementButton() : JButton
        + getGridSize() : Integer
    }

    class PlacementScreen {
        - _fixedPlacementButton : JButton
        - _randomPlacementButton : JButton
        - _startGameButton : JButton
        - _backButton : JButton
        + <<Create>> PlacementScreen(gridSize : Integer)
        + getBackButton() : JButton
    }

    class StartScreen {
        - _playButton : JButton
        - _quitButton : JButton
        + <<Create>> StartScreen()
        + getPlayButton() : JButton
        + getQuitButton() : JButton
    }

    class EndScreen

    class TerminalOutput

    class MainFrame {
        + <<Create>> MainFrame()
        - updateScreen(panel : JPanel)
    }

    class ShipView {

    }
}

package controller {
    class GridController {
        +placeShip(ship: Ship, position: Position, orientation: Orientation): boolean
    }

    class ShipController {
        +createShip(type: ShipType): Ship
    }

    class GameController {
        +startGame(): void
        +endGame(): void
    }
}

package util {
    class RandomUtil {

    }
}

' Relationships
Main --> GameController
GameController --> GridController
GameController --> ShipController
GridController --> Grid
ShipController --> ShipFactory

Grid "1" o-> "*" CellState : contient >
Grid "1" o-> "*" Ship : contient >

ShipFactory .> Ship : Crée
Ship "1" *-> "1" ShipType : est de type >
Ship "1" *-> "1" Orientation : est orienté >


MainFrame "1" *-> "1" StartScreen : contient >
MainFrame "1" *-> "1" ConfigScreen : contient >
MainFrame "1" *-> "1" PlacementScreen : contient >

PlacementScreen "1" *-> "1" LabeledGridView : affiche >

LabeledGridView "1" *-> "1" GridView : contient >

GridView "1" o-> "*" CellView : contient >

ShipView "1" *-> "1" Ship : représente >

GameView "1" *-> "2" LabeledGridView : affiche >

@enduml