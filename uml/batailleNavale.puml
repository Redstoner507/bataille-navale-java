@startuml BatailleNavale
'https://plantuml.com/class-diagram

'skinparam linetype ortho
'skinparam linetype polyline
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
hide enum methods
hide interface attributes

class Main {
    +main(args: String[]): void
}

package model {

    class GameConfig {
        - _gridSize : Integer
        - _islandsEnabled : Boolean
        - _shipConfig : Map<ShipType, Integer>
        + <<Create>> GameConfig()
        + getGridSize() : Integer
        + setGridSize(gridSize: Integer)
        + isIslandsEnabled() : Boolean
        + setIslandsEnabled(islandsEnabled: Boolean)
        + getShipConfig() : Map<ShipType, Integer>
        + setShipNumber(shipType: ShipType, number: Integer)
    }

    enum Orientation {
        HORIZONTAL
        VERTICAL
    }

    class Grid {
        - {static} MIN_SIZE : Integer
        - {static} MAX_SIZE : Integer
        - _size : Integer
        + <<Create>> Grid(size: Integer)
        + canPlaceShip(ship: Ship, startRow: Integer, startCol: Integer) : Boolean
        + placeShip(ship: Ship, startRow: Integer, startCol: Integer) : Boolean
        + getSize() : Integer
        + getCell(row: Integer, col: Integer) : Cell
        + getShips() : Ship[*]
    }

    abstract class Weapon {

    }

    abstract class Placeable {
        - _name : String
        - _size : Integer
        - _startRow : Integer
        - _startCol : Integer
        + <<Create>> Placeable(size: Integer, defaultOrientation: Orientation, name: String)
        + getSize() : Integer
        + setOrientation(orientation: Orientation)
        + getOrientation() : Orientation
        + getName() : String
        + setStartPosition(row: Integer, col: Integer)
        + getStartRow() : Integer
        + getStartCol() : Integer
        + getCoordinates() : Point[*]
    }

    package cell {
        abstract class Cell {
            - _isHit : Boolean
            + {abstract} <<Create>> Cell()
            + {abstract} hit() : void
            + isHit() : Boolean
            + getType() : CellType
        }

        enum CellType {
            WATER
            ISLAND
        }

        class WaterCell extends Cell {
            - _isHit : Boolean
            - _hasShip : Boolean
            - _isSunk : Boolean
            _ _ship : Ship
            + <<Create>> WaterCell()
            + isHit() : Boolean
            + hasShip() : Boolean
            + getShip() : Ship
            + isSunk() : Boolean
            + hit() : void
            + placeShip(newShip: Ship) : void
        }

        class IslandCell extends Cell {
            - _isHit : Boolean
            - _hasWeapon : Boolean
            _ _weapon : Weapon
            + <<Create>> IslandCell()
            + isHit() : Boolean
            + hasWeapon() : Boolean
            + getWeapon() : Weapon
            + hit() : void
            + placeWeapon(newWeapon: Weapon) : void
        }
    }

    package ship {
        class Ship extends model.Placeable{
            + <<Create>> Ship(size: Integer, name: String)
        }

        enum ShipType {
            CARRIER
            BATTLESHIP
            CRUISER
            SUBMARINE
            DESTROYER
        }

        class ShipFactory {
            + <<Create>> ShipFactory()
            + createCarrier() : Ship
            + createBatteShip() : Ship
            + createCruiser() : Ship
            + createSubmarine() : Ship
            + createDestroyer() : Ship
        }

        class Carrier extends Ship {
            + <<Create>> Carrier()
        }
        class BattleShip extends Ship {
            + <<Create>> BattleShip()
        }
        class Cruiser extends Ship {
            + <<Create>> Cruiser()
        }
        class Submarine extends Ship {
            + <<Create>> Submarine()
        }
        class Destroyer extends Ship {
            + <<Create>> Destroyer()
        }
    }
}

package view {
    class GameView {
        + <<Create>> GameView(gridSize : Integer, cellSize : Integer)
        + getPlayerGridView() : LabeledGridView
        + getComputerGridView() : LabeledGridView
        + setStatus(text: String)
    }

    class LabeledGridView {
        + <<Create>> LabeledGridView(title: String, gridSize: Integer, cellSize: Integer)
        + <<Create>> LabeledGridView(title: String, gridSize: Integer, cellSize: Integer, locked: Boolean)
        - setupComponents()
        + getGridView() : GridView
        + setTitle(title: String)
    }

    class GridView {
        - _gridSize : Integer
        - _locked : Boolean
        + <<Create>> GridView(gridSize: Integer, cellSize: Integer)
        + setLocked(locked: Boolean)
        + setCellEnabled(row: Integer, col: Integer, enabled: Boolean)
        + addCellClickListener(listener: ActionListener)
        + setGridActionListener(listener: GridActionListener)
        + notifyShipDropped(shipView: ShipView, row: Integer, col: Integer) : Boolean
        + getCell(row: Integer, col: Integer) : CellView
        + getGridSize() : Integer
        + isLocked() : Boolean
        + getGrid() : Grid
    }

    class CellView {
        - _segmentImage : Image
        - _isClickable : Boolean
        - _cellPosition : Point
        - _cellSize : Integer
        + <<Create>> CellView(cellPosition: Point, cellSize: Integer)
        + setSegmentImage()
        # paintComponent(g: Graphics)
        + addMouseListener(l: MouseListener)
        + setClickable(clickable: Boolean)
        + isClickable() : Boolean
        + getCellPosition() : Point
    }

    class ShipView {
        + <<Create>> ShipView(ship: Ship)
    }

    class ConfigScreen {
        - {static} MAX_OCCUPIABLE_CELLS : Integer
        + <<Create>> ConfigScreen(gameController: GameController, configController: ConfigController)
        - getOccupiedCellsCount() : Integer
        - updateOccupiedCellsLabel(occupiedCells: Integer)
        + getGridSize() : Integer
    }

    class PlacementScreen {
        - {static} SHIP_PANEL_WIDTH : Integer
        - {static} LABEL_HEIGHT : Integer
        + <<Create>> PlacementScreen(gameController: GameController, gridSize: Integer, ships: Ships[*], cellSize: Integer, PlacementController placementController)
    }

    class StartScreen {
        + <<Create>> StartScreen(gameController: GameController)
    }

    class EndScreen

    class TerminalOutput

    class MainFrame {
        - {static} START : String
        - {static} CONFIG : String
        - {static} PLACEMENT : String
        + <<Create>> MainFrame()
        + addScreen(name: String, screen: JPanel)
        + showScreen(name: String)
    }

    class ShipView {
        - _topLayer : JLayeredPane
        - _originalPanel : JPanel
        - _cellSize : Integer
        - _dragging : Boolean
        - _dragOffset : Point
        - _segmentPanel : JPanel
        + <<Create>> ShipView(ship: ShipView, grid: LabeledGridView, topLayer: JLayeredPane, originalPanel: JPanel, cellSize: Integer)
        - loadSegments()
        - updateSize()
        + setOrientation(orientation: Orientation)
        - initDragAndDrop()
        + getShip() : Ship
    }
}

package controller {
    class GridController {
        +placeShip(ship: Ship, position: Position, orientation: Orientation): Boolean
    }

    class GameController {
        - {static} CELL_SIZE : Integer
        + <<Create>> GameController()
        + showStartScreen()
        + showConfigScreen()
        + startPlacementScreen(shipConfig: Dictionary<String, Integer>, gridSize: Integer)
        + quit()
    }

    class PlacementController {
        + <<Create>> PlacementController()
        + placeShip(modelGrid: Grid, viewGrid: GridView, ship: Ship, row: Integer, col: Integer) : Boolean
        + rotateShip(ship: Ship)
    }

    interface GridActionListener {
        shipDropped(shipView: ShipView, row: Integer, col: Integer) : Boolean
    }

    class ConfigController {
        + <<Create>> ConfigController()
        + getShipConfig(config: Dictionary<String, Integer>) : Ship[*]
        + getShipConfig(carriers : Integer, batteShips : Integer, cruisers : Integer, submarines : Integer, destroyer : Integer) : Ship[*]
        + setGridSize(gridSize: Integer)
        + setShipNumber(shipType: ShipType, number: Integer)
        + getGameConfig() : GameConfig
    }
}

package util {
    class RandomUtil {

    }

    class ShipImageProvider {
        - {static} BASE_PATH : String
        - {static} _segmentBase : Image
        + {static} getShipSegment(cellSize: Integer) : Image
    }
}

' Relationships
Main .> GameController : Instancie >

GameController "1" *-> "1" MainFrame : Gère l'affichage de >
GameController "1" *-> "1" ConfigController : Partage la configuration >
GameController .> MainFrame : Instancie >
GameController .> ConfigScreen : Instancie >
GameController .> ConfigController : Instancie >
GameController .> StartScreen : Instancie >
GameController .> PlacementScreen : Instancie >
GameController .> PlacementController : Instancie >

GridController --> Grid

ConfigController "1" *-> "1" GameConfig : Contrôle >
ConfigController .> GameConfig : Instancie >
ConfigController .> ShipFactory : Instancie >

Cell "1" *-> "1" CellType : est de type >

WaterCell "1" *-> "0,1" Ship : peut contenir >
IslandCell "1" *-> "0,1" Weapon : peut contenir >

Grid "1" o-> "*" Cell : contient >
Grid "1" o-> "*" Ship : contient >

Placeable "1" *-> "1" Orientation : est orienté >

ShipFactory .> Ship : Instancie >

PlacementScreen "1" *-> "1" Orientation : est orienté >
PlacementScreen .> PlacementController : demande le placement des bateaux >

LabeledGridView "1" *-> "1" GridView : contient >

GridView "1" o-> "*" CellView : contient >
GridView "1" *-> "1" Grid : représente >
GridView "1" *-> "1" GridActionListener : est écouté par >

CellView "1" *-> "1" Cell : représente >
CellView .> ShipImageProvider : demande l'image >

ShipView "1" *-> "1" Ship : représente >
ShipView "1" *-> "1" LabeledGridView : peut être déplacé dans >
ShipView "1" *-> "1" Orientation : est orienté >
ShipView .> ShipImageProvider : demande l'image >

GameView "1" *-> "2" LabeledGridView : affiche >

PlacementController "1" *-> "1" Grid : a comme modèle >
PlacementController "1" *-> "1" GridView : a comme vue >
@enduml